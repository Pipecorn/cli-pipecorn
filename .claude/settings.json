{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run format)",
      "Bash(npm run docs)",
      "Bash(npm run check:schemas)",
      "Bash(npm run dev:*)"
    ],
    "deny": [
      "Bash(npm publish:*)",
      "Bash(git tag:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
