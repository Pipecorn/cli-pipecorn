class Pronto < Formula
  desc "Command-line interface for Pronto (B2B sales intelligence)"
  homepage "https://github.com/prontohq/cli-pronto"
  version "{{VERSION}}"
  url "https://github.com/prontohq/cli-pronto/releases/download/v{{VERSION}}/pronto-v{{VERSION}}-{{TARGET}}.tar.gz"
  sha256 "{{SHA256}}"
  license "MIT"

  def install
    libexec.install Dir["*"]
    bin.install_symlink libexec/"bin/pronto"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/pronto --version")
  end
end
